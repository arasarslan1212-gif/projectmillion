# ---- Data -------------------------------------------------------------------------------
# live   = call providers over the network
# mock   = replay fixtures only (no network, no keys needed)
# record = call providers and save every response as a fixture (see scripts/record_fixtures.py)
DATA_MODE=mock
# Fixture set for mock mode: recorded (real data you captured), synthetic (generated, fake
# tickers ZZ*/ZQ*), or auto (recorded if present, else synthetic). Sets are never mixed.
FIXTURE_SET=auto
# free | starter | pro. Enables/disables features by data availability (see PLAN.md §2).
DATA_TIER=starter

# SEC requires a descriptive User-Agent with a contact email (fair-access policy).
SEC_USER_AGENT="YourAppName your-email@example.com"
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# starter/pro tiers (analyst price targets, estimates, profile, news): financialmodelingprep.com
FMP_API_KEY=
# News and recommendation trends (free tier available): finnhub.io
FINNHUB_API_KEY=
# Free-tier EOD prices (personal use only): tiingo.com
TIINGO_API_KEY=
# pro tier: Benzinga analyst ratings via massive.com (formerly Polygon)
MASSIVE_API_KEY=

# ---- LLM (optional; without it every narrative uses validated templates) -----------------
ANTHROPIC_API_KEY=
FAST_MODEL=claude-haiku-4-5-20251001
REASONING_MODEL=claude-sonnet-5
LLM_REPORT_TOKEN_BUDGET=60000

# ---- Storage & runtime ------------------------------------------------------------------
# SQLite for local dev; compose uses PostgreSQL.
DATABASE_URL=sqlite:///./services/engine/dev.db
ENABLE_SCHEDULER=false
CORS_ORIGINS=http://localhost:3000
# Pin "today" (YYYY-MM-DD) for reproducible runs; leave empty for the real date.
AS_OF_OVERRIDE=
# Web → engine
ENGINE_URL=http://127.0.0.1:8000
